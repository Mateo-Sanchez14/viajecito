# Copy to .env for local runs (python-dotenv style, read by environs). Real env vars win.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
PUBLIC_ORIGIN=http://localhost:3000

# Defaults live under <repo>/data when unset.
# DATABASE_PATH=../data/db.sqlite3
# MEDIA_ROOT=../data/media
# STATIC_ROOT=../data/static

GOWA_BASE_URL=http://localhost:4000
GOWA_BASIC_AUTH_USER=
GOWA_BASIC_AUTH_PASS=
GOWA_WEBHOOK_SECRET=
# Optional: the bot's JID (<digits>@s.whatsapp.net), sent as X-Device-Id and skipped in roster syncs.
GOWA_DEVICE_ID=
# Inbound processing: 1 runs inline instead of on a worker thread (tests use 1).
MESSAGING_PROCESS_SYNC=0
INBOUND_STUCK_MINUTES=2
ROSTER_SYNC_HOURS=24
ROSTER_SYNC_MIN_INTERVAL_SECONDS=300

# OTP login (WhatsApp one-time codes). The pepper keys the HMAC of stored codes; required in prod.
OTP_PEPPER=dev-only-pepper-change-me
OTP_DELIVERY_ENABLED=1
OTP_CODE_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Trust CF-Connecting-IP for rate limiting. Leave 0 unless every request arrives via cloudflared
# (prod defaults to 1).
TRUST_CF_CONNECTING_IP=0

# Pass WhatsApp mention JIDs to Gowa (field name unconfirmed); 0 renders @<digits> only
GOWA_MENTIONS_ENABLED=0
