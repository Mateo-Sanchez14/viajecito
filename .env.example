# Copy to .env (never commit it). Consumed by docker-compose.yml.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_PATH=/data/db.sqlite3
MEDIA_ROOT=/data/media
STATIC_ROOT=/data/static
GOWA_BASE_URL=http://fake-gowa:4000
GOWA_BASIC_AUTH_USER=
GOWA_BASIC_AUTH_PASS=
GOWA_WEBHOOK_SECRET=dev-webhook-secret
API_INTERNAL_URL=http://api:8000
OTP_DELIVERY_ENABLED=1
OTP_PEPPER=dev-otp-pepper-change-me
OTP_CODE_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Pass WhatsApp mention JIDs to Gowa (field name unconfirmed); 0 renders @<digits> only
GOWA_MENTIONS_ENABLED=0
