# Copy to /srv/viajecito/pi.env on the Pi, then: chmod 600 /srv/viajecito/pi.env
# Host-only values: compose interpolation (--env-file), the systemd units and deploy/scripts/*.sh.
# The api container never sees this file (app variables are in api.env).
# Format rules (compose reads this file with format: raw and scripts/lib.sh parses it literally):
# KEY=value, one per line, no quotes, no spaces around "=", no "$" expansion.
# Keep values to [A-Za-z0-9._~+/=:-]; generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# (token_urlsafe also emits "_", which is fine).

# --- Images ---------------------------------------------------------------------------------
# GitHub owner (user or org) that publishes ghcr.io/<owner>/viajecito-{api,web}. Lowercase.
GHCR_OWNER=example
# latest, a release tag (v0.1.0) or a commit sha. Pin a sha/tag to roll back.
IMAGE_TAG=latest

# --- Cloudflare tunnel ----------------------------------------------------------------------
# Token of the tunnel created in Cloudflare Zero Trust > Networks > Tunnels (see deploy/cloudflared/README.md).
# Handed only to the cloudflared container.
TUNNEL_TOKEN=replace-with-the-tunnel-token
# Public hostname (no scheme) used by smoke.sh. Must equal the host in PUBLIC_ORIGIN of api.env.
PUBLIC_HOST=viajecito.example.com

# --- Backups (restic) -----------------------------------------------------------------------
# Any restic repository URL, e.g. s3:s3.amazonaws.com/bucket/viajecito, b2:bucket:viajecito or /mnt/usb/restic.
# Initialize once: /srv/viajecito/scripts/restic.sh init. Other backends need their own credential
# variables (AWS_ACCESS_KEY_ID, B2_ACCOUNT_ID, ...): add them here, they are exported to restic.
BACKUP_RESTIC_REPOSITORY=/srv/viajecito/restic-repo
BACKUP_RESTIC_PASSWORD=replace-with-a-restic-password
# Optional healthchecks.io-style ping URL, called after each successful backup. Leave empty to disable.
HEALTHCHECKS_URL=
