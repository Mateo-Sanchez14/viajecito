# Copy to /srv/viajecito/pi.env on the Pi, then: chmod 600 /srv/viajecito/pi.env
# Read by docker compose (--env-file + env_file) and sourced by deploy/scripts/*.sh.
# Format rules: KEY=value, one per line, no quotes, no spaces around "=", no "$" expansion.

# --- Django (api) ---------------------------------------------------------------------------
# Long random string. Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=replace-with-a-long-random-string
# Public origin served through the Cloudflare tunnel (no trailing slash). Drives ALLOWED_HOSTS and CSRF.
PUBLIC_ORIGIN=https://viajecito.example.com
# Paths inside the container; /data is bind-mounted from /srv/viajecito/data. Leave as is.
DATABASE_PATH=/data/db.sqlite3
MEDIA_ROOT=/data/media
STATIC_ROOT=/data/static

# --- OTP login ------------------------------------------------------------------------------
# Server-side pepper for OTP hashes. Generate like DJANGO_SECRET_KEY. Changing it invalidates live codes.
OTP_PEPPER=replace-with-another-long-random-string
# 1 = send login codes through Gowa; 0 = kill switch (api answers 503 delivery_unavailable).
OTP_DELIVERY_ENABLED=1
# Behind cloudflared the real client IP is in CF-Connecting-IP. Keep 1 in production.
TRUST_CF_CONNECTING_IP=1

# --- Gowa (WhatsApp gateway running on gastito's droplet) -----------------------------------
# MUST match gastito's droplet: the same Gowa instance, so use the same base URL and credentials.
GOWA_BASE_URL=https://gowa.example.com
# MUST match gastito's droplet Gowa basic-auth credentials.
GOWA_BASIC_AUTH_USER=replace-me
GOWA_BASIC_AUTH_PASS=replace-me
# MUST match gastito's droplet Gowa webhook secret (Gowa signs every webhook with it, for every URL).
GOWA_WEBHOOK_SECRET=replace-with-the-gowa-webhook-secret
# Optional: Gowa device id, sent as X-Device-Id. Leave empty for a single-device Gowa.
GOWA_DEVICE_ID=

# --- Cloudflare tunnel ----------------------------------------------------------------------
# Token of the tunnel created in Cloudflare Zero Trust > Networks > Tunnels (see deploy/cloudflared/README.md).
TUNNEL_TOKEN=replace-with-the-tunnel-token

# --- Images ---------------------------------------------------------------------------------
# GitHub owner (user or org) that publishes ghcr.io/<owner>/viajecito-{api,web}. Lowercase.
GHCR_OWNER=example
# latest, a release tag (v0.1.0) or a commit sha. Pin a sha/tag to roll back.
IMAGE_TAG=latest

# --- Backups (restic) -----------------------------------------------------------------------
# Any restic repository URL, e.g. s3:s3.amazonaws.com/bucket/viajecito, b2:bucket:viajecito or /mnt/usb/restic.
# Initialize once: restic init   (see deploy/README.md). Other backends need their own credential
# variables (AWS_ACCESS_KEY_ID, B2_ACCOUNT_ID, ...): add them here, backup.sh exports everything it reads.
BACKUP_RESTIC_REPOSITORY=/srv/viajecito/restic-repo
BACKUP_RESTIC_PASSWORD=replace-with-a-restic-password
# Optional healthchecks.io-style ping URL, called after each successful backup. Leave empty to disable.
HEALTHCHECKS_URL=
