# Copy to /srv/viajecito/api.env on the Pi, then: chmod 600 /srv/viajecito/api.env
# Read ONLY by the api container (env_file). Host-only values (tunnel token, backups, image tag) live in pi.env.
# Format rules (compose reads this file with format: raw and scripts/lib.sh parses it literally):
# KEY=value, one per line, no quotes, no spaces around "=", no "$" expansion.
# Keep values to [A-Za-z0-9._~+/=:-]; generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# (token_urlsafe also emits "_", which is fine).

# --- Django ---------------------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-string
# Public origin served through the Cloudflare tunnel (no trailing slash). Drives ALLOWED_HOSTS and CSRF.
PUBLIC_ORIGIN=https://viajecito.example.com
# Paths inside the container; /data is bind-mounted from /srv/viajecito/data. Leave as is.
DATABASE_PATH=/data/db.sqlite3
MEDIA_ROOT=/data/media
STATIC_ROOT=/data/static

# --- OTP login ------------------------------------------------------------------------------
# Server-side pepper for OTP hashes. Changing it invalidates live codes.
OTP_PEPPER=replace-with-another-long-random-string
# 1 = send login codes through the WhatsApp provider; 0 = kill switch (api answers 503 delivery_unavailable).
OTP_DELIVERY_ENABLED=1
# Behind cloudflared the real client IP is in CF-Connecting-IP. Keep 1 in production.
TRUST_CF_CONNECTING_IP=1

# --- WhatsApp provider --------------------------------------------------------------------------
# waha = the WAHA container already running on the Pi (production); gowa = gastito's Gowa (dev/e2e, legacy).
WHATSAPP_PROVIDER=waha

# --- WAHA (only read when WHATSAPP_PROVIDER=waha) -----------------------------------------------
# WAHA's compose project "waha" runs on the network waha_default with alias "waha"; the api joins it (compose.pi.yml).
WAHA_BASE_URL=http://waha:3000
# The WAHA API key (sent as X-Api-Key). Same value WAHA was started with.
WAHA_API_KEY=replace-me
# Name of the WAHA session of the dedicated bot number.
WAHA_SESSION=default
# HMAC key WAHA signs webhooks with (SHA-512). Put the same value in the session webhook config (deploy/README.md).
WAHA_WEBHOOK_HMAC_KEY=replace-with-a-long-random-string
# Extra Host header values the api accepts: WAHA calls http://viajecito-api:8000 over the Docker network.
EXTRA_ALLOWED_HOSTS=viajecito-api

# --- Gowa (only needed when WHATSAPP_PROVIDER=gowa; ignored with waha) --------------------------
# WhatsApp gateway on gastito's droplet.
# MUST match gastito's droplet: same Gowa instance, so same base URL and credentials.
GOWA_BASE_URL=https://gowa.example.com
GOWA_BASIC_AUTH_USER=replace-me
GOWA_BASIC_AUTH_PASS=replace-me
# MUST match gastito's droplet Gowa webhook secret (Gowa signs every webhook URL with it).
GOWA_WEBHOOK_SECRET=replace-with-the-gowa-webhook-secret
# Optional: Gowa device id, sent as X-Device-Id. Leave empty for a single-device Gowa.
GOWA_DEVICE_ID=

# Pass WhatsApp mention JIDs to Gowa (field name unconfirmed); 0 renders @<digits> only
GOWA_MENTIONS_ENABLED=0

# --- Wave A reminders and ski ---------------------------------------------------------------
DECISIONS_NUDGE_WINDOW_HOURS=48
DECISIONS_NUDGE_AFTER_DAYS=3
SKI_TICK_BUDGET_SECONDS=30
SKI_MANUAL_REPORTS_PER_HOUR=6

# Optional browser push: leave all VAPID values empty to disable push.
# Generate matching keys with: python manage.py generate_vapid_keys
# Subject: mailto: contact or https: origin; empty uses PUBLIC_ORIGIN when HTTPS.
NOTIFICATIONS_VAPID_PUBLIC_KEY=
NOTIFICATIONS_VAPID_PRIVATE_KEY=
NOTIFICATIONS_VAPID_SUBJECT=
# Empty uses the built-in push-service allowlist:
# fcm.googleapis.com, updates.push.services.mozilla.com, push.services.mozilla.com,
# *.push.apple.com, *.notify.windows.com
NOTIFICATIONS_PUSH_ENDPOINT_HOSTS=
NOTIFICATIONS_PUSH_BUDGET_SECONDS=10

# --- Proposal link previews and optional LLM classifier ------------------------------------
# static = canned previews (offline dev/e2e); httpx = SSRF-guarded live previews.
LINKPREVIEW_FETCHER=httpx
LINKPREVIEW_FETCH_SYNC=0
LINKPREVIEW_MAX_BYTES=1048576
# Disabled by default; configure all LLM values before enabling.
PROPOSALS_LLM_CLASSIFIER_ENABLED=0
PROPOSALS_LLM_BASE_URL=
PROPOSALS_LLM_API_KEY=
PROPOSALS_LLM_MODEL=

# --- Wave B logistics and encrypted document vault ---------------------------------------
LOGISTICS_NAG_LEAD_DAYS=3
DOCUMENTS_MAX_UPLOAD_BYTES=15728640
DOCUMENTS_TRIP_QUOTA_BYTES=1073741824
FILE_UPLOAD_MAX_MEMORY_SIZE=2621440
DATA_UPLOAD_MAX_MEMORY_SIZE=2621440
# Default upload allowlist (leave unset unless intentionally restricting supported formats):
# DOCUMENTS_ALLOWED_MIME=application/pdf,image/jpeg,image/png,image/webp,image/heic,image/heif
# REQUIRED in production: generate a fresh key locally, then paste it here (never commit secrets).
# python3 -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
# Ordered rotation list: new,old; first key encrypts, all keys decrypt. No spaces or quotes.
# Commas are allowed ONLY as separators for DOCUMENTS_FERNET_KEYS (not general env values).
# Retain old keys while any existing documents or backups still require them. See deploy/README.md.
DOCUMENTS_FERNET_KEYS=
